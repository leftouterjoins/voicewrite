<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Agent app (no dock icon) -->
    <key>LSUIElement</key>
    <true/>

    <!-- Microphone permission description -->
    <key>NSMicrophoneUsageDescription</key>
    <string>VoiceWrite needs microphone access to transcribe your speech into text.</string>

    <!-- Bundle identifiers -->
    <key>CFBundleIdentifier</key>
    <string>com.voicewrite.app</string>

    <key>CFBundleName</key>
    <string>VoiceWrite</string>

    <key>CFBundleDisplayName</key>
    <string>VoiceWrite</string>

    <key>CFBundleVersion</key>
    <string>20</string>

    <key>CFBundleShortVersionString</key>
    <string>1.3.2</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>CFBundleExecutable</key>
    <string>VoiceWrite</string>

    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>

    <!-- Supports automatic graphics switching -->
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- Sparkle Update Configuration -->
    <key>SUFeedURL</key>
    <string>https://leftouterjoins.github.io/voicewrite/appcast.xml</string>

    <key>SUPublicEDKey</key>
    <string>CUlfTMJ+QAiruV6RsNikqThAZDiIFQOEixwN+V3J7xI=</string>

    <!-- Silent auto-update (downloads in background, installs on restart) -->
    <key>SUAutomaticallyUpdate</key>
    <true/>

    <key>SUEnableAutomaticChecks</key>
    <true/>

    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
