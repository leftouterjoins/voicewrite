    <item>
      <title>Version 1.4.0</title>
      <link>https://github.com/leftouterjoins/voicewrite/releases/tag/v1.4.0</link>
      <sparkle:version>22</sparkle:version>
      <sparkle:shortVersionString>1.4.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <h2>What's New in 1.4.0</h2>
        <ul>
          <li>Multi-language support with per-language hotkeys</li>
          <li>Headset button language assignment</li>
          <li>On-device text refinement (removes filler words, fixes self-corrections)</li>
          <li>Custom vocabulary/dictionary for names and technical terms</li>
          <li>Language switcher in menu bar</li>
          <li>Reorganized settings UI with Language and Dictionary tabs</li>
        </ul>
      ]]></description>
